# =============================================================================
# PORTAL TANIN — variáveis de ambiente
# Copie para `.env` e preencha. Nada aqui vai para o Git.
# =============================================================================

# -----------------------------------------------------------------------------
# BANCO DE DADOS (obrigatório)
# -----------------------------------------------------------------------------
# É o endereço completo do Postgres, com usuário e senha dentro.
#
# NO SUPABASE: painel → Project Settings → Database → Connection string → URI.
# Use a opção "Transaction pooler" (porta 6543) na Vercel, porque lá cada requisição
# abre uma conexão nova e o pooler é quem aguenta isso. Para rodar migrações, use a
# "Session pooler" (porta 5432).
#
# Exemplo (troque [SENHA] pela senha do banco, definida na criação do projeto):
# DATABASE_URI=postgresql://postgres.[REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres
#
# EM DESENVOLVIMENTO, APONTE PARA UM BANCO LOCAL. Rodar o desenvolvimento contra a
# produção parece prático e é uma armadilha: `pnpm seed --limpar` apaga o conteúdo
# semeado e não pergunta em qual banco está. Para rodar uma migração contra a
# produção, exporte a variável só naquele comando:
#   DATABASE_URI='...' DATABASE_SSL=true pnpm migrate
DATABASE_URI=postgresql://postgres@127.0.0.1:5432/tanin

# O Supabase exige conexão criptografada. Deixe `true` em produção.
DATABASE_SSL=false

# Quantas conexões simultâneas o pool mantém. 10 é confortável na Vercel.
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# SEGREDO DO PAYLOAD (obrigatório)
# -----------------------------------------------------------------------------
# Assina os cookies de login do painel. Qualquer texto longo e aleatório serve.
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Se trocar, todo mundo é deslogado — o que é inofensivo.
PAYLOAD_SECRET=troque-por-um-texto-longo-e-aleatorio

# -----------------------------------------------------------------------------
# ENDEREÇO DO SITE (obrigatório em produção)
# -----------------------------------------------------------------------------
# Sem barra no fim. Entra nos links canônicos, no sitemap, no RSS e no JSON-LD.
NEXT_PUBLIC_URL_SITE=http://localhost:3000

# -----------------------------------------------------------------------------
# SUPABASE — API pública
# -----------------------------------------------------------------------------
# Não são usadas pelo Payload (que fala direto com o Postgres pelo DATABASE_URI).
# Ficam registradas para o dia em que o portal precisar do Storage ou do Realtime.
NEXT_PUBLIC_SUPABASE_URL=https://ekdglgmbyhnngippohvh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_HqkSlNbSRH7k7o-wsI6-7A_Y3nkWrz_

# -----------------------------------------------------------------------------
# ARMAZENAMENTO DE IMAGENS (obrigatório em produção)
# -----------------------------------------------------------------------------
# A Vercel apaga os arquivos a cada deploy, então as imagens precisam morar fora.
# O portal fala o dialeto S3, que serve tanto para o Storage do Supabase quanto
# para AWS S3 e Cloudflare R2. Sem estas quatro variáveis, as imagens ficam no
# disco local — o que funciona bem em desenvolvimento e não funciona em produção.
#
# NO SUPABASE: Storage → crie um bucket público chamado `midia`; depois
# Project Settings → Storage → S3 Access Keys → New access key.
# S3_BUCKET=midia
# S3_ENDPOINT=https://ekdglgmbyhnngippohvh.storage.supabase.co/storage/v1/s3
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# BEEHIIV
# -----------------------------------------------------------------------------
# Usado por duas coisas: o formulário de inscrição do site e o script que importa
# as edições antigas. Sem a chave, o formulário ainda funciona — as inscrições
# ficam guardadas no painel, em "Inscrições no Boletim", para sincronizar depois.
#
# ONDE ACHAR: beehiiv → Settings → Integrations → API (requer plano Scale).
# BEEHIIV_API_KEY=
# BEEHIIV_PUBLICATION_ID=pub_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
